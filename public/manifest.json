{
    "manifest_version": 3,
    "name": "Gemini Live Translator",
    "version": "1.0.0",
    "description": "Real-time AI translation by Gemini",
    "permissions": [
        "sidePanel"
    ],
    "side_panel": {
        "default_path": "index.html"
    },
    "action": {
        "default_title": "Open Translator"
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "vite.svg",
        "48": "vite.svg",
        "128": "vite.svg"
    }
}